{
  "opencollection": "1.0.0",
  "info": {
    "name": "AT&T Number Verification API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Number Verification",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "AT&T Verify Phone Number",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.att.com/camara/number-verification/v1/verify",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.att.com/oauth/v4/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Verify that the device making the request is associated with the provided phone number. The verification is performed silently using the mobile network connection without requiring the user to enter a code, providing frictionless authentication for mobile applications."
        }
      ]
    }
  ],
  "bundled": true
}