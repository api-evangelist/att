          "name": "AT&T Get Device Connectivity Status",
          "request": {
            "name": "AT&T Get Device Connectivity Status",
            "description": {
              "content": "Get the current connectivity status of a device identified by its phone number or IP address. Returns whether the device is connected to the AT&T network, the connection type, and whether the device is roaming.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "connectivity"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "accessTokenUrl",
                  "value": "https://api.att.com/oauth/v4/token"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device\": {\n    \"phoneNumber\": \"<string>\",\n    \"ipv4Address\": {\n      \"publicAddress\": \"<string>\",\n      \"privateAddress\": \"<string>\",\n      \"publicPort\": \"<integer>\"\n    },\n    \"networkAccessIdentifier\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
