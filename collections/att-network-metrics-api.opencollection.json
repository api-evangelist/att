{
  "opencollection": "1.0.0",
  "info": {
    "name": "AT&T Network Metrics API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Network Metrics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "AT&T Get Network Performance Metrics",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.att.com/network/insights/v1/metrics",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.att.com/oauth/v4/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve current network performance metrics for a specific device or location. Returns signal strength, network generation (4G/5G), throughput estimates, and latency indicators."
        }
      ]
    }
  ],
  "bundled": true
}