{
  "opencollection": "1.0.0",
  "info": {
    "name": "AT&T Order Management API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://devex-web.att.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Order Management",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List AT&T Enterprise Product Orders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://devex-web.att.com/alliance/productOrder/v1",
            "params": [
              {
                "name": "state",
                "value": "",
                "type": "query",
                "description": "Filter by order state"
              },
              {
                "name": "requestedStartDate.gt",
                "value": "",
                "type": "query",
                "description": "Filter orders with requested start date after this date"
              },
              {
                "name": "externalId",
                "value": "",
                "type": "query",
                "description": "Filter by external order ID"
              }
            ]
          },
          "docs": "Retrieve a list of product orders with optional filtering by state, date range, or external ID."
        },
        {
          "info": {
            "name": "Get AT&T Enterprise Product Order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://devex-web.att.com/alliance/productOrder/v1/:orderId",
            "params": [
              {
                "name": "orderId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the current status and details of a specific product order."
        }
      ]
    }
  ],
  "bundled": true
}