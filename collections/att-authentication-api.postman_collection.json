          "id": "ca5e2bc7-a463-470d-939f-07e48213196c",
          "name": "AT&T Get OAuth Access Token",
          "request": {
            "name": "AT&T Get OAuth Access Token",
            "description": {
              "content": "Obtain an OAuth 2.0 access token using client credentials grant type. The token is required for all subsequent API calls.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth",
                "v4",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) The App Key from your AT&T developer account"
                },
                {
                  "disabled": false,
                  "key": "client_secret",
                  "value": "<string>",
                  "description": "(Required) The App Secret from your AT&T developer account"
                },
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) OAuth grant type"
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "(Required) Space-separated list of API scopes (e.g. SMS, MMS, SPEECH)"
                },
                {
                  "disabled": false,
                  "key": "code",
                  "value": "<string>",
                  "description": "Authorization code (required for authorization_code grant type)"
                },
                {
                  "disabled": false,
                  "key": "refresh_token",
                  "value": "<string>",
                  "description": "Refresh token (required for refresh_token grant type)"
                }
              ]
            }
          },
          "response": [
            {
              "id": "cbf1790c-a585-4f3b-b35a-d82f22e34904",
