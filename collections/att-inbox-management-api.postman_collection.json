        {
          "id": "bfa72e26-b368-49b6-90fc-4c88f852f413",
          "name": "AT&T Get Inbox Changes (Delta Sync)",
          "request": {
            "name": "AT&T Get Inbox Changes (Delta Sync)",
            "description": {
              "content": "Retrieve changes to the user's inbox since the last synchronization using a state token. Returns added, updated, and deleted messages since the previous state. Requires a message index to be created first.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "myMessages",
                "v2",
                "delta"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "(Required) State token from the previous delta sync or index creation"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "IMMN MIM"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://api.att.com/oauth/v4/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://api.att.com/oauth/v4/authorize"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
