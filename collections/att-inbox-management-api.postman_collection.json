          "name": "AT&T Create Message Index Cache",
          "request": {
            "name": "AT&T Create Message Index Cache",
            "description": {
              "content": "Create or refresh the server-side message index cache for the authenticated user. This index must be created before delta synchronization can be used. Returns a state object for subsequent delta sync calls.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "myMessages",
                "v2",
                "messages",
                "index"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "IMMN MIM"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://api.att.com/oauth/v4/token"
                },
                {
