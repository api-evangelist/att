                        "value": "application/x-www-form-urlencoded"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "urlencoded",
                      "urlencoded": [
                        {
                          "description": "(Required) The App Key from your AT&T developer account",
                          "key": "client_id",
                          "value": "<string>"
                        },
                        {
                          "description": "(Required) The App Secret from your AT&T developer account",
                          "key": "client_secret",
