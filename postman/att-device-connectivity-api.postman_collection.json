      "item": [
        {
          "name": "AT&T Get Device Connectivity Status",
          "id": "d9dc450d-c983-45b4-9e0d-733e8b86dbe0",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "accessTokenUrl",
                  "value": "https://api.att.com/oauth/v4/token",
                  "type": "string"
                },
                {
                  "key": "grant_type",
