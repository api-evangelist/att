                {
                  "name": "inbox",
                  "item": [
                    {
                      "name": "{registrationId}",
                      "item": [
                        {
                          "name": "AT&T Get Inbound SMS Messages",
                          "id": "83c99cc7-80a3-4dc2-a9e1-e73450201ef6",
                          "protocolProfileBehavior": {
                            "disableBodyPruning": true
                          },
                          "request": {
                            "auth": {
                              "type": "oauth2",
                              "oauth2": [
                                {
                                  "key": "scope",
                                  "value": "IMMN MIM",
                                  "type": "string"
                                },
                                {
                                  "key": "accessTokenUrl",
                                  "value": "https://api.att.com/oauth/v4/token",
                                  "type": "string"
                                },
                                {
                                  "key": "authUrl",
                                  "value": "https://api.att.com/oauth/v4/authorize",
                                  "type": "string"
                                },
                                {
                                  "key": "grant_type",
                                  "value": "authorization_code",
                                  "type": "string"
                                }
                              ]
                            },
                            "method": "GET",
                            "header": [
                              {
                                "key": "Accept",
                                "value": "application/json"
                              }
                            ],
                            "url": {
                              "raw": "{{baseUrl}}/sms/v3/messaging/inbox/:registrationId",
                              "host": [
                                "{{baseUrl}}"
                              ],
                              "path": [
                                "sms",
                                "v3",
                                "messaging",
                                "inbox",
                                ":registrationId"
                              ],
                              "variable": [
                                {
                                  "id": "a1b6035c-59d5-4c35-972d-92d0683e0931",
                                  "key": "registrationId",
                                  "value": "<string>",
                                  "description": "(Required) The short code registration ID from the AT&T developer account"
                                }
                              ]
