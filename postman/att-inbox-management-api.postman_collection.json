                    "disableBodyPruning": true
                  },
                  "request": {
                    "auth": {
                      "type": "oauth2",
                      "oauth2": [
                        {
                          "key": "scope",
                          "value": "IMMN MIM",
                          "type": "string"
                        },
                        {
                          "key": "accessTokenUrl",
                          "value": "https://api.att.com/oauth/v4/token",
                          "type": "string"
                        },
                        {
